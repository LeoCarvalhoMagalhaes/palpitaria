{
  "name": "palpitaria",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/spa-fallback.mjs",
    "build:pages": "tsc -b && cross-env GITHUB_PAGES=true vite build && node scripts/spa-fallback.mjs",
    "build:test": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint src",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "data:mundareu": "node scripts/data/mundareu/build.mjs",
    "data:na-etiqueta": "node scripts/data/na-etiqueta/build.mjs",
    "data:palavreta": "python -I scripts/data/words/expand_vero.py scripts/.cache/vero scripts/.cache/words && python -I scripts/data/palavreta/build.py .",
    "data:mais-ou-menos": "node scripts/data/mais-ou-menos/build.mjs",
    "data:holofote": "node scripts/data/holofote/build.mjs && node scripts/data/holofote/enrich.mjs",
    "data:rastro": "node scripts/data/rastro/build.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "fuse.js": "^7.5.0",
    "globe.gl": "^2.46.2",
    "lucide-react": "^1.62.0",
    "motion": "^14.7.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@huggingface/transformers": "^4.3.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@turf/turf": "^7.4.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
